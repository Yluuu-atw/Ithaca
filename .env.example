# ITHACA_AI_TEXT_BASE_URL=https://api.deepseek.com
# ITHACA_AI_TEXT_MODEL=deepseek-flash
# ITHACA_AI_TEXT_API_KEY=

# Optional separate provider for screenshot recognition.
